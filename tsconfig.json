{
    "compilerOptions": {
        "target": "ES2020",
        "useDefineForClassFields": true,
        "module": "ESNext",
        "moduleResolution": "Bundler",

        "strict": true,
        "jsx": "preserve",

        "resolveJsonModule": true,
        "isolatedModules": true,
        "esModuleInterop": true,

        "lib": [
            "ES2020",
            "DOM",
            "DOM.Iterable"
        ],

        "types": [
            "vite/client"
        ],

        "skipLibCheck": true
    },

    "include": [
        "resources/js/**/*.ts",
        "resources/js/**/*.d.ts",
        "resources/js/**/*.vue"
    ]
}